{
  "manifest_version": 3,
  "name": "JobMatch AI",
  "version": "1.1.0",
  "description": "Smart job matching + auto-fill applications based on your CV. Score jobs, fill forms, track applications.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://www.glassdoor.com/*",
    "https://www.monster.com/*",
    "https://www.ziprecruiter.com/*",
    "https://jobs.lever.co/*",
    "https://boards.greenhouse.io/*",
    "https://apply.workable.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.taleo.net/*",
    "https://*.smartrecruiters.com/*",
    "https://*.breezy.hr/*",
    "https://*.ashbyhq.com/*",
    "https://*.bamboohr.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/feed/*",
        "https://www.indeed.com/*",
        "https://www.glassdoor.com/*",
        "https://www.monster.com/*",
        "https://www.ziprecruiter.com/*"
      ],
      "js": [
        "utils/storage.js",
        "utils/cv-parser.js",
        "utils/job-matcher.js",
        "content/autofill.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css",
        "content/autofill.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobs.lever.co/*",
        "https://boards.greenhouse.io/*",
        "https://apply.workable.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.taleo.net/*",
        "https://*.smartrecruiters.com/*",
        "https://*.breezy.hr/*",
        "https://*.ashbyhq.com/*",
        "https://*.bamboohr.com/*"
      ],
      "js": [
        "utils/storage.js",
        "content/autofill.js",
        "content/content.js"
      ],
      "css": [
        "content/autofill.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "libs/pdf.min.mjs",
        "libs/pdf.worker.min.mjs",
        "libs/mammoth.browser.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}